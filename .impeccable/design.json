  "narrative": {
    "northStar": "The Developer's Workspace — Console Focused",
    "overview": "A technical, personal, and direct workspace built from terminal conventions: monospaced text, command prompts, bordered panels, and a segmented Vim-style status line. The owner has confirmed the console focus and the existing Catppuccin palette. This document records the restored implementation, not a selected replacement page concept.\n\nThe approved direction favors flat panels distinguished by borders and background tones. Controls should remain precise and console-inspired while understandable without command knowledge. The current implementation is evidence, not proof that every interaction already meets that goal. Understanding business requirements is part of the professional positioning in `PRODUCT.md`, not a decorative motif.",
    "keyCharacteristics": [
      "Console identity with visible actions alongside commands.",
      "Cascadia Code for the header; FiraCode for main content.",
      "Catppuccin Latte and Mocha, with restrained tonal depth.",
      "Rectangular panels and a distinctive segmented status line."
    ],
    "rules": [
      {
        "name": "The Palette Fidelity Rule",
        "body": "Preserve the existing Catppuccin values. Do not silently turn this documentation pass into a palette correction or normalize the incomplete light-theme assignments.",
        "section": "colors"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Use tone and borders for hierarchy, not decorative floating-card shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the console-focused workspace identity and Catppuccin palette.",
      "**Do** keep actions understandable without requiring command knowledge.",
      "**Do** use flat panels, borders, and tonal separation.",
      "**Do** distinguish observed implementation details from approved future guidance."
    ],
    "donts": [
      "**Don't** add decorative shadows to create floating panels.",
      "**Don't** replace confirmed palette values or invent a new font pairing during documentation.",
      "**Don't** present missing interaction states or light-theme assignments as already implemented.",
      "**Don't** treat this record as approval of a replacement page layout."
    ]
  }
