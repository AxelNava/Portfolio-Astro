---
import { Image } from 'astro:assets';
import Copy from './Copy.astro';
import principalCompilador from '../assets/img/Projects/Compilador/Captura de pantalla_20230220_131721.webp';
import compilador1 from '../assets/img/Projects/Compilador/Captura de pantalla 2025-03-21 110645.webp';
import compilador2 from '../assets/img/Projects/Compilador/Captura de pantalla 2025-03-21 112732.webp';
import compilador4 from '../assets/img/Projects/Compilador/Captura de pantalla 2025-03-21 114041.webp';
import compilador5 from '../assets/img/Projects/Compilador/Captura de pantalla 2025-03-21 114116.webp';
import principalDesktop from "../assets/img/Projects/Administrador_de_usuarios_creador_de_PDF's/Impresión2.webp";
import desktop1 from "../assets/img/Projects/Administrador_de_usuarios_creador_de_PDF's/Menú.webp";
import desktop2 from "../assets/img/Projects/Administrador_de_usuarios_creador_de_PDF's/Impresión1.webp";
import desktop3 from "../assets/img/Projects/Administrador_de_usuarios_creador_de_PDF's/ModificarUsuario.webp";
import desktop4 from "../assets/img/Projects/Administrador_de_usuarios_creador_de_PDF's/Subir información.webp";
import principalWeb from '../assets/img/Projects/comercializate/Captura desde 2025-03-19 08-48-40.webp';
import web1 from '../assets/img/Projects/comercializate/Captura desde 2025-03-19 08-48-57.webp';
import web2 from '../assets/img/Projects/comercializate/Captura desde 2025-03-19 08-48-45.webp';
import web3 from '../assets/img/Projects/comercializate/Captura desde 2025-03-19 08-49-10.webp';
import web4 from '../assets/img/Projects/comercializate/Captura desde 2025-03-19 08-50-09.webp';
import web5 from '../assets/img/Projects/comercializate/Captura desde 2025-03-19 08-49-41.webp';
import principalVideogame from '../assets/img/Projects/unity/unity.webp';

const webEvidence = [web1, web2, web3, web4, web5];
const desktopEvidence = [
  { src: desktop1, es: 'Menú de la aplicación de recibos de agua', en: 'Water receipt application menu' },
  { src: desktop2, es: 'Impresión de recibos de agua', en: 'Water receipt printing' },
  { src: desktop3, es: 'Edición de un usuario del servicio de agua', en: 'Editing a water service user' },
  { src: desktop4, es: 'Carga de información en la aplicación de recibos', en: 'Uploading information to the receipt application' },
];
const compilerEvidence = [compilador1, compilador2, compilador4, compilador5];
---

<section id="projects" aria-labelledby="projects-title">
  <div class="section-heading">
    <h2 id="projects-title"><Copy es="Proyectos" en="Projects" /></h2>
    <span class="section-path" aria-hidden="true">~/projects</span>
  </div>
  <div class="project-workspace">
    <aside class="project-sidebar" aria-label="Projects / Proyectos">
      <div class="project-overviews">
        <div data-project-summary="project-web">
          <h3><Copy es="Comercializate" en="Comercializate" /></h3>
          <p class="category"><Copy es="Desarrollo web" en="Web development" /></p>
          <p class="project-relationship"><Copy es="Freelance · Comercializate / RC Performance. Mismo diseño del panel, con diferentes reglas de negocio." en="Freelance · Comercializate / RC Performance. The same panel layout, with different business rules." /></p>
      <p><Copy es="Panel de administración de Comercializate para que los usuarios gestionen sus propios datos y un administrador pueda gestionarlos también." en="Comercializate administration panel where users can manage their own data and an administrator can manage it too." /></p>
        </div>
        <div data-project-summary="project-desktop">
          <h3><Copy es="Recibos de agua" en="Water receipts" /></h3>
          <p class="category"><Copy es="Aplicación de escritorio" en="Desktop application" /></p>
      <p><Copy es="Propuesta para administrar usuarios del servicio de agua y generar recibos en PDF, con SQLite como base de datos." en="A proposal to manage water service users and generate PDF receipts, using SQLite as the database." /></p>
        </div>
        <div data-project-summary="project-compiler">
          <h3><Copy es="Compilador" en="Compiler" /></h3>
          <p class="category"><Copy es="Herramientas de desarrollo" en="Development tools" /></p>
      <p><Copy es="Compilador escrito en C# para un pequeño conjunto de instrucciones de C#. La última fase desarrollada fue la generación de código intermedio." en="A compiler written in C# for a small subset of C# instructions. Intermediate code generation was the last development phase." /></p>
        </div>
        <div data-project-summary="project-piano">
          <h3><Copy es="Pianista en escritorio" en="Pianista on desktop" /></h3>
          <p class="category"><Copy es="Videojuego" en="Video game" /></p>
      <p><Copy es="Pequeña adaptación para escritorio del videojuego móvil Pianista, un intento de replicar sus mecánicas usando archivos MIDI." en="A small desktop adaptation of the mobile game Pianista, attempting to replicate its mechanics using MIDI files." /></p>
        </div>
      </div>
      <nav class="project-list" aria-label="Select project / Seleccionar proyecto">
          <a id="tab-project-web" href="#project-web"><Copy es="Comercializate" en="Comercializate" /><span class="work-indicator">[work: freelance]</span></a>
          <a id="tab-project-desktop" href="#project-desktop"><Copy es="Recibos de agua" en="Water receipts" /></a>
          <a id="tab-project-compiler" href="#project-compiler"><Copy es="Compilador" en="Compiler" /></a>
          <a id="tab-project-piano" href="#project-piano"><Copy es="Pianista en escritorio" en="Pianista on desktop" /></a>
      </nav>
    </aside>
    <div class="project-panels">
      <article id="project-web" class="project-panel">
        <div class="project-detail">

      <ul>
        <li><Copy es="Diseño responsivo" en="Responsive design" /></li>
        <li><Copy es="Administración de usuarios y gestión de sus propios datos" en="User administration and self-service data management" /></li>
      </ul>
      <p><Copy es="En RC Performance trabajé con el mismo diseño de panel, pero con diferentes reglas de negocio: diseño responsivo, permisos por roles, generación de PDF y Excel, operaciones con múltiples bases de datos, edición manual de datos y administración básica de inventario. Las imágenes mostradas son de Comercializate, no de RCPerformance." en="At RC Performance I worked with the same panel layout, but with different business rules: responsive design, role-based permissions, PDF and Excel generation, operations across multiple databases, manual data editing and basic inventory management. The images shown are from Comercializate, not RCPerformance." /></p>
      <div class="project-preview">
        <a href={principalWeb.src}>
          <Image src={principalWeb} width={principalWeb.width} alt="Vista principal del panel de Comercializate" data-alt-es="Vista principal del panel de Comercializate" data-alt-en="Main view of the Comercializate panel" />
        </a>
      </div>
      <details class="evidence">
        <summary><Copy es="Ver más capturas de Comercializate" en="See more Comercializate screenshots" /></summary>
        <div class="evidence-grid">
          {webEvidence.map((image, index) => (
            <a href={image.src}>
              <Image src={image} width={image.width} alt={`Captura ${index + 1} del panel de Comercializate`} data-alt-es={`Captura ${index + 1} del panel de Comercializate`} data-alt-en={`Comercializate panel screenshot ${index + 1}`} />
            </a>
          ))}
        </div>
      </details>
        </div>
      </article>
      <article id="project-desktop" class="project-panel">
        <div class="project-detail">

      <ul>
        <li><Copy es="Administración de usuarios y carga de archivos Excel y CSV" en="User administration and Excel and CSV file uploads" /></li>
        <li><Copy es="Generación de recibos para todos los usuarios o un rango" en="Receipt generation for all users or a selected range" /></li>
        <li><Copy es="Incremento mensual de la deuda al abrir la aplicación" en="Monthly debt increases when the application is opened" /></li>
      </ul>
      <div class="project-preview">
        <a href={principalDesktop.src}>
          <Image src={principalDesktop} width={principalDesktop.width} alt="Vista de impresión de recibos de agua" data-alt-es="Vista de impresión de recibos de agua" data-alt-en="Water receipt printing view" />
        </a>
      </div>
      <details class="evidence">
        <summary><Copy es="Ver más capturas de la aplicación" en="See more application screenshots" /></summary>
        <div class="evidence-grid">
          {desktopEvidence.map((image) => (
            <a href={image.src.src}>
              <Image src={image.src} width={image.src.width} alt={image.es} data-alt-es={image.es} data-alt-en={image.en} />
            </a>
          ))}
        </div>
      </details>
        </div>
      </article>
      <article id="project-compiler" class="project-panel">
        <div class="project-detail">

      <ul>
        <li><Copy es="Analizadores léxico y semántico de implementación propia" en="Custom lexical and semantic analyzers" /></li>
        <li><Copy es="Analizador sintáctico con el algoritmo LR(1)" en="Syntax analyzer using the LR(1) algorithm" /></li>
        <li><Copy es="Generación propia de código intermedio de tres direcciones" en="Custom three-address intermediate code generation" /></li>
      </ul>
      <p><Copy es="A partir del código fuente, muestra errores y evalúa operaciones matemáticas que pueden expresarse en notación prefija. Si el código es válido, crea un archivo de texto con el código intermedio." en="Given source code, it reports errors and evaluates mathematical operations that can be expressed in prefix notation. If the code is valid, it creates a text file with the intermediate code." /></p>
      <div class="project-preview">
        <a href={principalCompilador.src}>
          <Image src={principalCompilador} width={principalCompilador.width} alt="Vista principal del compilador" data-alt-es="Vista principal del compilador" data-alt-en="Main view of the compiler" />
        </a>
      </div>
      <details class="evidence">
        <summary><Copy es="Ver más capturas del compilador" en="See more compiler screenshots" /></summary>
        <div class="evidence-grid">
          {compilerEvidence.map((image, index) => (
            <a href={image.src}>
              <Image src={image} width={image.width} alt={`Captura ${index + 1} del compilador`} data-alt-es={`Captura ${index + 1} del compilador`} data-alt-en={`Compiler screenshot ${index + 1}`} />
            </a>
          ))}
        </div>
      </details>
        </div>
      </article>
      <article id="project-piano" class="project-panel">
        <div class="project-detail">

      <ul>
        <li><Copy es="Desarrollado con Unity y archivos MIDI de creación propia" en="Developed with Unity and self-created MIDI files" /></li>
        <li><Copy es="Jugabilidad con teclado y captura de varias teclas simultáneas" en="Keyboard gameplay with simultaneous key presses" /></li>
      </ul>
      <div class="project-preview">
        <a href={principalVideogame.src}>
          <Image src={principalVideogame} width={principalVideogame.width} alt="Vista del juego de piano para escritorio" data-alt-es="Vista del juego de piano para escritorio" data-alt-en="Desktop piano game view" />
        </a>
      </div>
        </div>
      </article>
    </div>
  </div>
</section>
