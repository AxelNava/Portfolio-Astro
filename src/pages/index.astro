---
import Layout from '../layouts/Layout.astro';
import Copy from '../components/Copy.astro';
import Projects from '../components/Projects.astro';
import ImageViewer from '../components/ImageViewer.astro';
---

<Layout>
  <a class="skip-link" href="#experience"><Copy es="Saltar a experiencia" en="Skip to experience" /></a>
  <div class="workspace">
    <header class="workspace-header">
      <div class="file-bar">
        <div class="file-tabs">
          <a class="file-name" href="#" data-portfolio-tab>axel-nava / portfolio</a>
          <button type="button" class="file-tab" data-viewer-tab hidden><Copy es="capturas" en="screenshots" /></button>
        </div>
        <div class="language-controls" role="group" aria-label="Language / Idioma">
          <button type="button" data-language="es" aria-pressed="true" lang="es">Español</button>
          <button type="button" data-language="en" aria-pressed="false" lang="en">English</button>
        </div>
      </div>
      <div class="identity">
        <div>
          <h1>Axel Nava<span class="cursor" aria-hidden="true">_</span></h1>
          <p class="role"><Copy es="Desarrollador FullStack" en="FullStack Developer" /></p>
        </div>
        <p class="intro"><Copy es="Software para web, escritorio y herramientas. Entiendo el negocio para convertir sus necesidades en soluciones técnicas." en="Software for the web, desktop and developer tools. I understand the business to turn its needs into technical solutions." /></p>
      </div>
      <nav class="section-nav" aria-label="Portfolio">
        <a id="tab-experience" href="#experience"><Copy es="Experiencia" en="Experience" /></a>
        <a id="tab-projects" href="#projects"><Copy es="Proyectos" en="Projects" /></a>
        <a id="tab-contact" href="#contact"><Copy es="Contacto" en="Contact" /></a>
      </nav>
    </header>

    <main id="main-content">
      <section id="experience" aria-labelledby="experience-title">
        <div class="section-heading">
          <h2 id="experience-title"><Copy es="Experiencia" en="Experience" /></h2>
          <span class="section-path" aria-hidden="true">~/experience</span>
        </div>
        <article class="experience-row current-role">
          <div class="date-rail">
            <p><time datetime="2025-10-08"><Copy es="08 oct 2025" en="08 Oct 2025" /></time><br /><Copy es="— actualidad" en="— present" /></p>
            <span class="current-label"><Copy es="Actual" en="Current" /></span>
          </div>
          <div class="experience-detail">
            <h3>Unilink</h3>
            <p class="position"><Copy es="Analista de Desarrollo" en="Development Analyst" /></p>
            <p><Copy es="Migración de proyectos, mantenimiento de sistemas legacy y nuevas funcionalidades para un negocio B2B." en="Project migration, legacy system maintenance and new features for a B2B business." /></p>
            <ul>
              <li><Copy es="Liderazgo técnico en la migración de proyectos .NET Framework." en="Technical leadership in migrating .NET Framework projects." /></li>
              <li><Copy es="Unificación de tres proyectos similares mediante el patrón Strategy." en="Consolidation of three similar projects using the Strategy pattern." /></li>
              <li><Copy es="Desarrollo de notificaciones, herramientas para desarrollo con IA y estructuración de pruebas E2E." en="Development of notifications, AI-assisted development tools and E2E test structure." /></li>
            </ul>
            <div class="report-result">
              <p class="result-title"><Copy es="Optimización de reportes .NET" en=".NET reporting optimization" /></p>
              <p><strong><Copy es="50 % menos tiempo · 80 % menos RAM" en="50% less time · 80% less RAM" /></strong></p>
              <p><Copy es="En reportes con grandes volúmenes de datos; estos resultados corresponden a ese proceso, no a toda la plataforma." en="For reports processing large data volumes; these results apply to that process, not to the entire platform." /></p>
            </div>
          </div>
        </article>
        <article class="experience-row">
          <div class="date-rail"><p><Copy es="Experiencia anterior" en="Previous experience" /></p><span><Copy es="Casi 2 años" en="Nearly 2 years" /></span></div>
          <div class="experience-detail">
            <h3>Freelance</h3>
            <p class="position">Comercializate · RCPerformanceDiesel</p>
            <p><Copy es="Desarrollo web FullStack: paneles de administración, gestión de usuarios y funcionalidades para las operaciones del negocio." en="FullStack web development: administration panels, user management and features supporting business operations." /></p>
            <a class="text-link" href="#project-web" data-related-project><Copy es="Explorar los proyectos relacionados" en="Explore related projects" /><span aria-hidden="true"> →</span></a>
          </div>
        </article>
      </section>

      <Projects />

      <section id="contact" aria-labelledby="contact-title">
        <div class="section-heading">
          <h2 id="contact-title"><Copy es="Contacto" en="Contact" /></h2>
          <span class="section-path" aria-hidden="true">~/contact</span>
        </div>
        <div class="contact-content">
          <p><Copy es="¿Buscas un desarrollador para tu equipo o tu próximo proyecto? Hablemos." en="Looking for a developer for your team or your next project? Let's talk." /></p>
          <div class="contact-links">
            <a href="https://www.linkedin.com/in/axel-nava-516809289/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
            <a href="https://github.com/AxelNava" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          </div>
          <p class="spoken-languages"><Copy es="Idiomas: español e inglés." en="Languages: Spanish and English." /></p>
        </div>
      </section>
    </main>
    <ImageViewer />
    <footer class="status-line">
      <span class="status-mode">NORMAL</span>
      <span data-status-file>experience.md</span>
      <span class="status-end">web / desktop / tools</span>
    </footer>
  </div>
</Layout>

<script>
  import { initWorkspace } from '../scripts/tabs.mjs';
  initWorkspace();
  import { setLanguage } from '../scripts/locale.mjs';
  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-language]')) {
    button.addEventListener('click', () => setLanguage(button.dataset.language));
  }
  document.dispatchEvent(new Event('portfolio:ready'));
</script>
